# Copier ce fichier en .env puis remplir les valeurs. Ne JAMAIS commiter le .env.

# --- PostgreSQL (base metier) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=contacts_bde

# --- n8n ---
# Cle de chiffrement des credentials n8n.
# Installation neuve : generer une valeur aleatoire (ex. openssl rand -base64 24).
# Migration : reprendre EXACTEMENT la valeur "encryptionKey" de ~/.n8n/config.
N8N_ENCRYPTION_KEY=change-me
N8N_HOST=n8n.example.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.example.com

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
